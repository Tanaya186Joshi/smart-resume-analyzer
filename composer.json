{
  "name": "smartresumeanalyzer/analyzer",
  "description": "Smart Resume Analyzer - AI-powered resume analysis and ATS matching",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Smart Resume Analyzer Team",
      "email": "team@resumeanalyzer.local"
    }
  ],
  "require": {
    "php": ">=8.0",
    "smalot/pdfparser": "^2.0",
    "phpmailer/phpmailer": "^6.6",
    "ext-json": "*",
    "ext-mysqli": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "SmartResumeAnalyzer\\": "src/",
      "SmartResumeAnalyzer\\Api\\": "api/",
      "SmartResumeAnalyzer\\Config\\": "config/"
    },
    "files": [
      "config/helpers.php"
    ]
  },
  "scripts": {
    "install-deps": "composer install --no-dev",
    "dev-install": "composer install",
    "test": "phpunit",
    "lint": "phpcs",
    "fix": "phpcbf",
    "analyze": "phpstan analyse"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

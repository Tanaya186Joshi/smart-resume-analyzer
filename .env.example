# Smart Resume Analyzer - Environment Configuration
# Copy this file to .env and update with your actual values

# =================================================================================
# APPLICATION SETTINGS
# =================================================================================
APP_NAME="Smart Resume Analyzer"
APP_ENV="development"
APP_DEBUG="true"
APP_URL="http://localhost:8000"
APP_TIMEZONE="UTC"

# =================================================================================
# DATABASE CONFIGURATION
# =================================================================================
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="resume_analyzer"
DB_USER="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"

# =================================================================================
# SESSION & SECURITY
# =================================================================================
SESSION_LIFETIME="120"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_HTTPONLY="true"
SESSION_COOKIE_SAMESITE="Strict"
CSRF_TOKEN_LENGTH="32"
PASSWORD_RESET_TOKEN_EXPIRY="3600"

# =================================================================================
# NLP & API CONFIGURATION
# =================================================================================
# Choose API provider: "huggingface" or "openai"
NLP_API_PROVIDER="huggingface"

# HuggingFace Configuration
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"
HUGGINGFACE_MODEL="bert-base-uncased"
HUGGINGFACE_ENDPOINT="https://api-inference.huggingface.co/models"

# OpenAI Configuration (if using OpenAI instead)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-3.5-turbo"

# =================================================================================
# FILE UPLOAD CONFIGURATION
# =================================================================================
MAX_RESUME_SIZE="5242880"
UPLOAD_DIRECTORY="./uploads"
ALLOWED_MIME_TYPES="application/pdf"
ENABLE_VIRUS_SCAN="false"

# =================================================================================
# EMAIL CONFIGURATION (SMTP)
# =================================================================================
MAIL_DRIVER="smtp"
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT="2525"
MAIL_USERNAME="your_username"
MAIL_PASSWORD="your_password"
MAIL_FROM_ADDRESS="noreply@resumeanalyzer.com"
MAIL_FROM_NAME="Smart Resume Analyzer"
MAIL_ENCRYPTION="tls"

# =================================================================================
# SECURITY KEYS & TOKENS
# =================================================================================
APP_KEY="your_random_app_key_here_change_in_production"
JWT_SECRET="your_jwt_secret_key_here"

# =================================================================================
# RATE LIMITING
# =================================================================================
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_UPLOADS="10"
RATE_LIMIT_UPLOADS_WINDOW="3600"
RATE_LIMIT_API_CALLS="100"
RATE_LIMIT_API_WINDOW="3600"

# =================================================================================
# LOGGING
# =================================================================================
LOG_CHANNEL="stack"
LOG_LEVEL="debug"
LOG_PATH="./logs"
LOG_MAX_FILES="10"

# =================================================================================
# CACHE CONFIGURATION
# =================================================================================
CACHE_DRIVER="file"
CACHE_DURATION="3600"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# =================================================================================
# ADMIN SETTINGS
# =================================================================================
ADMIN_PANEL_URL="/admin"
ADMIN_SESSION_TIMEOUT="30"
ENABLE_ADMIN_ANALYTICS="true"

# =================================================================================
# PAGINATION
# =================================================================================
RESULTS_PER_PAGE="10"
MAX_PAGINATION_LINKS="5"

# =================================================================================
# FEATURE FLAGS
# =================================================================================
ENABLE_USER_REGISTRATION="true"
ENABLE_PASSWORD_RESET="true"
ENABLE_EMAIL_VERIFICATION="false"
ENABLE_TWO_FACTOR_AUTH="false"
ENABLE_SOCIAL_LOGIN="false"
ENABLE_API_ACCESS="true"

# =================================================================================
# EXTERNAL SERVICES
# =================================================================================
ENABLE_GOOGLE_ANALYTICS="false"
GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""
